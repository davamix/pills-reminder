<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The reminder permissions (P5). Every permission must be in the allowlist of plan §3, which the build checks
         (P1-D6). INTERNET is never allowed (NF-3). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Granted at install, and can't be revoked; it lets the app set its alarm clock (D-8). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Used by P7's reminder check (RM-9). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".PillsReminderApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PillsReminder">

        <!-- Portrait only (NF-7). The only exported component. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The reminders' receivers (P5 SPEC §4.3.6). None is exported: the alarm and the actions reach theirs through
             explicit PendingIntents, and the system delivers its own broadcasts. No android:process: the store works in
             one process only (P3). -->
        <receiver
            android:name=".reminders.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.SystemEventReceiver"
            android:exported="false">
            <!-- BOOT_COMPLETED goes to every app's receivers in turn, in priority order: 999, the highest an app may
                 use, brought it from 59 s to 8.7 s after the unlock (P5 Q9). -->
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- AndroidX's profile installer adds an exported receiver, guarded by DUMP, for adb and benchmark tools. Plan §3:
             only the launcher activity is exported (P8 T3). The profiles are still installed when the app starts. Lint
             reads the compile classpath, where the class isn't: the library is a runtime dependency of Compose. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>

</manifest>
